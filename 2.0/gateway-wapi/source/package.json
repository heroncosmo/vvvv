  "scripts": {
    "dev": "node scripts/run-dev.js",
    "build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/index.js",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "migrate": "tsx server/run-migrations.ts",
    "migrate:tickets-storage": "tsx server/migrate-ticket-attachments-to-supabase.ts",
    "deploy": "npm run vps:deploy",
    "deploy:v2": "echo Railway desativado para este projeto. Use npm run vps:deploy",
    "vps:preflight": "python scripts/deploy_safe_release.py preflight",
    "vps:status": "python scripts/deploy_safe_release.py status",
