NODE_ENV=production
PORT=5001
SERVICE_MODE=wa-gateway
SESSIONS_DIR=/data/whatsapp-sessions
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
WA_GATEWAY_INTERNAL_TOKEN=
WA_GATEWAY_EVENT_URL=http://api:5000/api/internal/wa-gateway/events
WA_GATEWAY_EVENT_OUTBOX_CONCURRENCY=6
DISABLE_WHATSAPP_PROCESSING=true
SKIP_WHATSAPP_RESTORE=true
ENABLE_WA_SESSION_SNAPSHOTS=false
WA_GATEWAY_EVENT_OUTBOX_DISABLED=true
