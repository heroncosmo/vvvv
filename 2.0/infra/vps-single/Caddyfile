{
	email {$ACME_EMAIL}
	admin off
}

{$AGENTEZAP_DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:5000 {
			health_uri /healthz
			health_interval 10s
			health_timeout 3s
		}
	}

	handle /healthz {
		reverse_proxy api:5000
	}

	handle {
		reverse_proxy web:5000 {
			health_uri /healthz
			health_interval 10s
			health_timeout 3s
		}
	}
}

{$AGENTEZAP_GATEWAY_DOMAIN} {
	encode zstd gzip

	respond "gateway staging disabled" 503
}
